{
  "name": "@app/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "prebuild": "pnpm run build:packages",
    "build:packages": "pnpm --dir packages/shared-types run build && pnpm --dir packages/scheduling-core run build",
    "build": "nest build",
    "dev": "node --max-old-space-size=2048 ./node_modules/@nestjs/cli/bin/nest.js start --watch -b swc",
    "dev:tsc": "node --max-old-space-size=2048 ./node_modules/@nestjs/cli/bin/nest.js start --watch",
    "prestart": "prisma migrate deploy && prisma generate",
    "start": "node dist/main",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:concurrency": "jest --testPathPattern=concurrency",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/bullmq": "^10.2.1",
    "@nestjs/common": "^10.3.8",
    "@nestjs/config": "^3.2.2",
    "@nestjs/core": "^10.3.8",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.8",
    "@nestjs/schedule": "^4.0.2",
    "@nestjs/swagger": "^7.3.1",
    "@nestjs/throttler": "^5.1.2",
    "@pkg/scheduling-core": "file:packages/scheduling-core",
    "@pkg/shared-types": "file:packages/shared-types",
    "@prisma/client": "^5.14.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.7.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "csrf-csrf": "^4.0.3",
    "date-fns": "^4.3.0",
    "date-fns-tz": "^3.2.0",
    "express": "^5.2.1",
    "googleapis": "^171.4.0",
    "ioredis": "^5.4.1",
    "luxon": "^3.4.4",
    "nodemailer": "^6.9.13",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prisma": "^5.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^22.1.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.2",
    "@nestjs/schematics": "^10.1.1",
    "@nestjs/testing": "^10.3.8",
    "@swc/cli": "^0.5.2",
    "@swc/core": "^1.15.40",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/luxon": "^3.4.2",
    "@types/node": "^20.12.12",
    "@types/nodemailer": "^6.4.15",
    "@types/passport-jwt": "^4.0.1",
    "@types/uuid": "^9.0.8",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  }
}
