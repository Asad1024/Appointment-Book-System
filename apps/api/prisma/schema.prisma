generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                    String    @id @default(uuid())
  name                  String
  slug                  String    @unique
  logoUrl               String?   @map("logo_url")
  primaryColor          String?   @default("#4f46e5") @map("primary_color")
  bookingCurrency       String    @default("aed") @map("booking_currency")
  allowedEmbedOrigins   String?   @map("allowed_embed_origins")
  webhookUrl            String?   @map("webhook_url")
  webhookSecret         String?   @map("webhook_secret")
  subscriptionPlan      String    @default("free") @map("subscription_plan")
  subscriptionStatus    String    @default("inactive") @map("subscription_status")
  subscriptionExpiresAt DateTime? @map("subscription_expires_at")
  paymentMethodLast4    String?   @map("payment_method_last4")
  paymentMethodBrand    String?   @map("payment_method_brand")
  stripeCustomerId      String?   @unique @map("stripe_customer_id")
  stripeSubscriptionId  String?   @unique @map("stripe_subscription_id")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  locations   Location[]
  users       User[]
  teamInvites TeamInvite[]

  @@map("organizations")
}

model Location {
  id                  String   @id @default(uuid())
  organizationId      String   @map("organization_id")
  name                String
  timezone            String   @default("UTC")
  address             String?
  phone               String?
  cancellationCutoffH Int      @default(24) @map("cancellation_cutoff_h")
  leadTimeMinutes     Int      @default(120) @map("lead_time_minutes")
  bookingWindowDays   Int      @default(60) @map("booking_window_days")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  providers    Provider[]
  services     Service[]
  appointments Appointment[]

  @@map("locations")
}

enum IntakeFieldType {
  text
  textarea
  select
  checkbox
  number
}

model User {
  id                      String    @id @default(uuid())
  organizationId          String    @map("organization_id")
  email                   String    @unique
  passwordHash            String    @map("password_hash")
  name                    String
  role                    String    @default("customer")
  providerId              String?   @unique @map("provider_id")
  emailVerified           Boolean   @default(false) @map("email_verified")
  emailVerifyToken        String?   @unique @map("email_verify_token")
  emailVerifyTokenExpires DateTime? @map("email_verify_token_expires")
  passwordResetToken      String?   @unique @map("password_reset_token")
  passwordResetExpires    DateTime? @map("password_reset_expires")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  organization  Organization      @relation(fields: [organizationId], references: [id])
  provider      Provider?         @relation(fields: [providerId], references: [id])
  customer      Customer?
  invitesSent   TeamInvite[]      @relation("InvitedBy")
  authoredNotes AppointmentNote[] @relation("NoteAuthor")

  @@map("users")
}

model TeamInvite {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  email          String
  role           String
  providerId     String?   @map("provider_id")
  token          String    @unique
  invitedById    String    @map("invited_by_id")
  expiresAt      DateTime  @map("expires_at")
  acceptedAt     DateTime? @map("accepted_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitedBy", fields: [invitedById], references: [id])

  @@index([organizationId, email])
  @@map("team_invites")
}

model Provider {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  locationId     String   @map("location_id")
  name           String
  email          String?
  bio            String?
  isActive       Boolean   @default(true) @map("is_active")
  archivedAt     DateTime? @map("archived_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  location          Location           @relation(fields: [locationId], references: [id])
  user              User?
  availabilityRules AvailabilityRule[]
  blockedTimes      BlockedTime[]
  serviceProviders  ServiceProvider[]
  appointments      Appointment[]
  waitlist          Waitlist[]
  calendarConnection ProviderCalendarConnection?

  @@index([locationId, archivedAt])
  @@map("providers")
}

model ProviderCalendarConnection {
  id           String   @id @default(uuid())
  providerId   String   @unique @map("provider_id")
  calendarType String   @default("google") @map("calendar_type")
  accessToken  String   @db.Text @map("access_token")
  refreshToken String   @db.Text @map("refresh_token")
  expiresAt    DateTime @map("expires_at")
  calendarId   String   @default("primary") @map("calendar_id")
  connectedAt  DateTime @default(now()) @map("connected_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("provider_calendar_connections")
}

model Service {
  id                  String   @id @default(uuid())
  organizationId      String   @map("organization_id")
  locationId          String   @map("location_id")
  productKey          String?  @map("product_key")
  name                String
  description         String?
  durationMinutes     Int      @map("duration_minutes")
  bufferBeforeMinutes Int      @default(0) @map("buffer_before_minutes")
  bufferAfterMinutes  Int      @default(10) @map("buffer_after_minutes")
  priceCents          Int?     @map("price_cents")
  requiresApproval    Boolean  @default(false) @map("requires_approval")
  isActive            Boolean   @default(true) @map("is_active")
  archivedAt          DateTime? @map("archived_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  location         Location          @relation(fields: [locationId], references: [id])
  serviceProviders ServiceProvider[]
  appointments     Appointment[]
  waitlist         Waitlist[]
  intakeFields     IntakeField[]

  @@index([locationId, archivedAt])
  @@map("services")
}

model IntakeField {
  id        String          @id @default(cuid())
  serviceId String          @map("service_id")
  service   Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  label     String
  helpText  String?         @map("help_text")
  type      IntakeFieldType
  options   Json?
  required  Boolean         @default(false)
  order     Int             @default(0)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  responses IntakeResponse[]

  @@index([serviceId, order])
  @@map("intake_fields")
}

model IntakeResponse {
  id            String      @id @default(cuid())
  appointmentId String      @map("appointment_id")
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  fieldId       String      @map("field_id")
  field         IntakeField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  value         String      @db.Text
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([appointmentId])
  @@map("intake_responses")
}

model ServiceProvider {
  serviceId  String @map("service_id")
  providerId String @map("provider_id")

  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@id([serviceId, providerId])
  @@map("service_providers")
}

model AvailabilityRule {
  id         String @id @default(uuid())
  providerId String @map("provider_id")
  dayOfWeek  Int    @map("day_of_week")
  startTime  String @map("start_time")
  endTime    String @map("end_time")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("availability_rules")
}

model BlockedTime {
  id         String   @id @default(uuid())
  providerId String   @map("provider_id")
  startUtc   DateTime @map("start_utc")
  endUtc     DateTime @map("end_utc")
  reason     String?

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("blocked_times")
}

model Customer {
  id        String   @id @default(uuid())
  userId    String?  @unique @map("user_id")
  name      String
  email     String
  phone     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User?         @relation(fields: [userId], references: [id])
  appointments Appointment[]

  @@unique([email])
  @@map("customers")
}

model Appointment {
  id               String    @id @default(uuid())
  organizationId   String    @map("organization_id")
  locationId       String    @map("location_id")
  serviceId        String    @map("service_id")
  providerId       String    @map("provider_id")
  customerId       String    @map("customer_id")
  startUtc         DateTime  @map("start_utc")
  endUtc           DateTime  @map("end_utc")
  timezone         String
  customerTimezone String?   @map("customer_timezone")
  status           String    @default("confirmed")
  statusUpdatedAt  DateTime? @map("status_updated_at")
  source           String    @default("web")
  product          String?
  campaign         String?
  returnUrl        String?   @map("return_url")
  metadata         String?
  idempotencyKey   String?   @unique @map("idempotency_key")
  manageToken      String    @unique @map("manage_token")
  rescheduleCount  Int       @default(0) @map("reschedule_count")
  reminderSent24h  Boolean   @default(false) @map("reminder_sent_24h")
  reminderSent1h   Boolean   @default(false) @map("reminder_sent_1h")
  notes            String?
  paymentStatus    String    @default("not_required") @map("payment_status")
  stripePaymentIntentId String? @unique @map("stripe_payment_intent_id")
  amountPaidCents  Int?      @map("amount_paid_cents")
  googleCalendarEventId String? @map("google_calendar_event_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  location         Location            @relation(fields: [locationId], references: [id])
  service          Service             @relation(fields: [serviceId], references: [id])
  provider         Provider            @relation(fields: [providerId], references: [id])
  customer         Customer            @relation(fields: [customerId], references: [id])
  events           AppointmentEvent[]
  notifications    NotificationLog[]
  review           Review?
  intakeResponses  IntakeResponse[]
  appointmentNotes AppointmentNote[]

  @@index([providerId, startUtc])
  @@index([locationId, startUtc])
  @@index([organizationId, status])
  @@map("appointments")
}

model AppointmentEvent {
  id            String   @id @default(uuid())
  appointmentId String   @map("appointment_id")
  action        String
  actorUserId   String?  @map("actor_user_id")
  actorEmail    String?  @map("actor_email")
  payload       String?
  createdAt     DateTime @default(now()) @map("created_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@map("appointment_events")
}

model NotificationLog {
  id            String    @id @default(uuid())
  appointmentId String    @map("appointment_id")
  type          String
  status        String    @default("pending")
  recipient     String
  errorMessage  String?   @map("error_message")
  sentAt        DateTime? @map("sent_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@map("notification_logs")
}

model Waitlist {
  id            String    @id @default(uuid())
  serviceId     String    @map("service_id")
  providerId    String?   @map("provider_id")
  preferredDate String    @map("preferred_date")
  customerEmail String    @map("customer_email")
  customerName  String    @map("customer_name")
  notifiedAt    DateTime? @map("notified_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  service  Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  provider Provider? @relation(fields: [providerId], references: [id], onDelete: SetNull)

  @@index([serviceId, preferredDate])
  @@map("waitlist")
}

model IdempotencyRecord {
  id        String   @id @default(uuid())
  key       String   @unique
  response  String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@map("idempotency_records")
}

model Review {
  id            String   @id @default(uuid())
  appointmentId String   @unique @map("appointment_id")
  rating        Int
  comment       String?  @db.Text
  customerName  String   @map("customer_name")
  createdAt     DateTime @default(now()) @map("created_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@map("reviews")
}

model AppointmentNote {
  id            String      @id @default(cuid())
  appointmentId String      @map("appointment_id")
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  authorId      String      @map("author_id")
  author        User        @relation("NoteAuthor", fields: [authorId], references: [id])
  content       String      @db.Text
  editedAt      DateTime?   @map("edited_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@index([appointmentId, createdAt])
  @@map("appointment_notes")
}
