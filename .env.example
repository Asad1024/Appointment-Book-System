# Local MySQL (MySQL 8+)
DATABASE_URL=mysql://root:YOUR_MYSQL_PASSWORD@localhost:3306/appointments

# Memurai / Redis — background notification jobs
REDIS_URL=redis://127.0.0.1:6379
USE_SYNC_NOTIFICATIONS=false

# API on 3003; web dev server on 3002 (see apps/web/package.json)
# If API still binds to 3001, check apps/api/.env — it overrides these values when present.
API_PORT=3003
# Public API URL for calendar .ics links in emails
API_PUBLIC_URL=http://localhost:3003
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_REFRESH_SECRET=change-me-refresh-secret
CSRF_SECRET=change-me-csrf-secret
CORS_ORIGIN=http://localhost:3002
WEB_URL=http://localhost:3002

# Web (also set in apps/web/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:3003

# Stripe — customer booking payments (hosted Checkout redirect)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_URL=https://your-ngrok-host.ngrok-free.dev/payments/webhook
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_BOOKING_CURRENCY=aed

# Email (optional — logs to console if SMTP_HOST is unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
EMAIL_FROM=noreply@yourcompany.com

# Google Calendar (provider OAuth — create credentials in Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3003/integrations/google/callback

# Unipile WhatsApp (customer appointment messages; runs alongside email)
UNIPILE_API_KEY=
UNIPILE_API_URL=https://api13.unipile.com:14348
UNIPILE_API_WHATSAPP=
DEFAULT_PHONE_COUNTRY_CODE=

# Seed script only (apps/api) — set in apps/api/.env or root .env, never commit real passwords
SEED_ADMIN_EMAIL=admin@yourdomain.com
SEED_ADMIN_PASSWORD=use-a-strong-local-password
SEED_PROVIDER_EMAIL_BASE=providers
SEED_PROVIDER_EMAIL_DOMAIN=yourdomain.com
